ARG PYTHON_BASE=python:3.11-slim
FROM ${PYTHON_BASE}
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && useradd -m benchuser
COPY --chown=benchuser:benchuser app /app/app
COPY --chown=benchuser:benchuser scripts/scale_isolated_app.py /app/scripts/scale_isolated_app.py
USER benchuser
