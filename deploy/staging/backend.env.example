# Copy to a protected file outside the repository and restrict it to the
# Oracle operator. Never commit the populated file.
PORT=8080
OPENAI_MODEL=gpt-4o
OPENAI_SCHEDULE_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=60
HISTORY_TOKEN_BUDGET=3000
AI_MAX_CONCURRENT_GENERATIONS=20
AI_MAX_QUEUED_GENERATIONS=40
AI_QUEUE_TIMEOUT_SECONDS=5
AI_USER_RATE_LIMIT_REQUESTS=20
AI_USER_RATE_LIMIT_WINDOW_SECONDS=60
AI_IP_RATE_LIMIT=120/minute
AI_REPLAY_TTL_SECONDS=120
AI_REPLAY_MAX_ENTRIES=200
AI_REPLAY_MAX_BYTES=262144
COORDINATION_BACKEND=redis
CORS_ALLOWED_ORIGINS=https://staging.kunivai.online
REDIS_URL=
REDIS_KEY_PREFIX=kuniv
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=3
AI_REQUEST_LEASE_MS=30000
AI_CAPACITY_LEASE_MS=120000
AI_REPLAY_MAX_EVENTS=2048
AI_REDIS_EPOCH=
AI_GLOBAL_GENERATION_RPM=300
AI_MAX_GENERATIONS_PER_USER=2
AI_MAX_QUEUED_PER_USER=2
AI_GENERATION_TIMEOUT_SECONDS=120
AI_SSE_PER_WORKER=128
AI_SSE_PER_USER=4
AI_SSE_GLOBAL=512
AI_SSE_MAX_SECONDS=180
AI_REDIS_CONTROL_CONNECTIONS=64
OPENAI_RPM_BUDGET=5000
OPENAI_TPM_BUDGET=450000
OPENAI_TOOL_TOKEN_RESERVATION=12000
OPENAI_DAILY_REQUEST_BUDGET=18000
OPENAI_DAILY_TOKEN_UNIT_BUDGET=30000000
OPENAI_DAILY_FILE_UPLOAD_BUDGET=20
OPENAI_DAILY_UNITS_PER_TOOL_CALL=4000
OPENAI_CONNECTIONS_PER_WORKER=32
CHAT_APP_CHECK_MODE=report
CHAT_APP_CHECK_APP_IDS=
KUNIV_METRICS_TOKEN=

# Supply these through the Oracle secret store or the operator's protected
# environment. Values are deliberately absent here.
OPENAI_API_KEY=
OPENAI_VECTOR_STORE_ID=
ANALYTICS_ID_PEPPER=

# Temporary reviewed UIDs only. Remove and recreate the container after the
# audited claims are established.
BOOTSTRAP_ADMIN_UIDS=
